# Copia este archivo a .env (que NO se sube a git) y cambia los valores.
POSTGRES_USER=energy
POSTGRES_PASSWORD=cambia-esta-clave
ALLOWED_ORIGINS=http://localhost:5173
WEB_HOST_PORT=5173

# Login del usuario demo. El hash es bcrypt; genéralo sin dejar la clave en el historial del shell:
#   echo -n 'tu-clave-de-8+-caracteres' | docker run --rm -i -v "$PWD/backend":/src -v energy-ai-gomod:/go/pkg/mod -w /src golang:1.24-alpine go run ./cmd/hashpw
# IMPORTANTE: el hash lleva "$" y va entre comillas simples, o Docker Compose lo interpreta como variable.
# JWT_SECRET: mínimo 32 caracteres aleatorios (ej. `openssl rand -hex 32`). No lo compartas ni lo subas a git.
AUTH_USER=demo
AUTH_PASSWORD_HASH='$2a$10$reemplaza-por-el-hash-generado'
JWT_SECRET=cambia-esto-por-32-o-mas-caracteres-aleatorios
JWT_TTL=8h

# LLM compatible con la API de OpenAI (OpenRouter, NVIDIA, etc.). Opcional:
# si LLM_API_KEY está vacía, las explicaciones salen de una plantilla determinista.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
