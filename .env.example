# Copia este archivo a .env (que NO se sube a git) y cambia los valores.
POSTGRES_USER=energy
POSTGRES_PASSWORD=cambia-esta-clave
ALLOWED_ORIGINS=http://localhost:5173

# LLM compatible con la API de OpenAI (OpenRouter, NVIDIA, etc.). Opcional:
# si LLM_API_KEY está vacía, las explicaciones salen de una plantilla determinista.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
